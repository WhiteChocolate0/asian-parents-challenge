{
  "name": "asian-parents-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check:functions": "node scripts/check-vercel-function-count.mjs",
    "predeploy": "npm test && npm run build && npm run check:functions",
    "test:db-options": "node --env-file=.env.development.local scripts/verify-option-constraint.mjs",
    "test:db:hackathon": "node --env-file=.env.hackathon.local scripts/hackathon-e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vercel/node": "^5.1.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
